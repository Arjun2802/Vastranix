# VASTRENIX — Environment Configuration Template
# DO NOT COMMIT SECRETS OR REAL KEYS TO VERSION CONTROL

PROJECT_NAME="VASTRENIX"
PROJECT_TAGLINE="Your Business, Beautifully in Sync."
ENVIRONMENT="development"  # "development" | "staging" | "production"
PORT=8000

# Secret Key for fallback session signing (in production, generate a secure random 64-char string)
SECRET_KEY="vastrenix-dev-super-secure-key-2026-garments-erp"

# Database & Storage
DATABASE_URL="sqlite:///./vastrenix.db"
STORAGE_DIR="./storage"

# ==============================================================================
# FIREBASE ADMIN SDK (Required for Production Render Deployment)
# ==============================================================================
# In Render Dashboard > Environment > Add Environment Variable:
# Key: FIREBASE_SERVICE_ACCOUNT_JSON
# Value: Paste the FULL JSON content of your downloaded service account key as a single-line string.
# Example: {"type": "service_account", "project_id": "vastranix-xxx", ...}
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional: Target Firebase Cloud Storage Bucket name
FIREBASE_STORAGE_BUCKET="vastrenix.firebasestorage.app"

# Local Development Only (Ignored in Production if FIREBASE_SERVICE_ACCOUNT_JSON is set)
FIREBASE_CREDENTIALS_PATH=
